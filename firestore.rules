rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ------------------ entity: user ------------------
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt'])
        && data.keys().size() == 5
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && data.role in ['teacher', 'student']
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      allow list: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      
      // Tiered update: Block role changes or profile takeover
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email']);
    }

    // ------------------ entity: class ------------------
    function isValidClass(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'teacherId', 'createdAt'])
        && data.keys().size() == 5
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.code is string && data.code.size() > 0 && data.code.size() <= 20
        && data.teacherId == request.auth.uid
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(classId) && isValidClass(request.resource.data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
        
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid
        && isValidClass(request.resource.data)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code']);
        
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // ------------------ entity: session ------------------
    function isValidSession(data) {
      return data.keys().hasAll(['id', 'classId', 'className', 'teacherId', 'token', 'expiredAt', 'createdAt', 'isActive'])
        && data.keys().size() == 8
        && data.id is string && data.id.size() <= 100
        && data.classId is string && data.classId.size() <= 100
        && data.className is string && data.className.size() <= 100
        && data.teacherId == request.auth.uid
        && data.token is string && data.token.size() <= 256
        && data.expiredAt is timestamp
        && (data.createdAt == request.time || data.createdAt is timestamp)
        && data.isActive is bool;
    }

    match /sessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSession(request.resource.data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId));
        
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'expiredAt', 'token']);
        
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // ------------------ entity: attendance ------------------
    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'sessionId', 'classId', 'className', 'studentId', 'studentName', 'studentEmail', 'timestamp', 'status'])
        && data.keys().size() >= 9
        && data.id is string && data.id.size() <= 200
        && data.sessionId is string && data.sessionId.size() <= 100
        && data.classId is string && data.classId.size() <= 100
        && data.className is string && data.className.size() <= 100
        && data.studentId == request.auth.uid
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 100
        && data.studentEmail is string && data.studentEmail.size() > 0 && data.studentEmail.size() <= 100
        && data.timestamp == request.time
        && data.status in ['present', 'late'];
    }

    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      
      // Enforce secure queries in allow list
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      
      // Relational validation: Verify active ticking session, valid student identity, and single create.
      allow create: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(request.resource.data)
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.isActive == true
        && request.time < get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.expiredAt;
        
      // No standard student updates (attendance is write-once and immutable!)
      allow update: if false;
      
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
  }
}
